---
const name = Astro.props.name;
const tech = Astro.props.tech;
const url = Astro.props.url;
---

<div class="project-container">
  <h1><a href={url} target="_blank">{name}</a></h1>
  <h2>{tech}</h2>
  <div class="content">
    <slot />
  </div>
</div>

<style>
  .project-container {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  h1 {
    font-size: 2rem;
    font-weight: 400;
    color: var(--accent);
  }
  h2 {
    font-size: 1.2rem;
    font-weight: 500;
    font-family: var(--condensed-font);
  }
  .content {
    color: var(--fg);
    font-family: var(--mono-font);
  }
</style>
